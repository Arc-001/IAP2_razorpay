# Postgres (Supabase/Neon in prod; docker-compose postgres locally)
DATABASE_URL=postgresql+psycopg://ap2:ap2@localhost:5433/ap2

# Razorpay test-mode keys (Dashboard -> Account & Settings -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# HMAC-SHA256 secret for signing Intent/Cart mandates (CLAUDE.md §1).
# Generate with: openssl rand -hex 32
MANDATE_SIGNING_SECRET=

# Separate secret for HTTP bearer-token auth (login sessions + OAuth access
# tokens) — deliberately NOT the same value as MANDATE_SIGNING_SECRET, so a
# leaked login token can never be replayed as a forged mandate signature.
# Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=

# LLM tool-calling goes through OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash

# Browser origins allowed to call this API. Defaults to Vite's dev port;
# set to the frontend's public URL when serving through a tunnel or deploy.
# CORS_ORIGINS=["http://localhost:5173"]

# --- Optional: OAuth for the MCP connector (Claude Desktop / claude.ai) ---
# Only needed if exposing the MCP server at api/mcp_server/ to a remote client.
# OAUTH_CLIENT_ID=ap2-claude-connector
# OAUTH_REDIRECT_URIS=["https://claude.ai/api/mcp/auth_callback"]
